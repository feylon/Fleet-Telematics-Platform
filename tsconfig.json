{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": false,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "target": "ES2022",
    "sourceMap": false,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": false,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "noImplicitAny": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "paths": {
      "@fleet/common": ["libs/common/src"],
      "@fleet/common/*": ["libs/common/src/*"],
      "@fleet/database": ["libs/database/src"],
      "@fleet/database/*": ["libs/database/src/*"]
    }
  },
  "include": ["apps/**/*.ts", "libs/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["node_modules", "dist", "frontend"]
}
