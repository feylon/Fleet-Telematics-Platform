{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "monorepo": true,
  "root": "apps/gateway",
  "sourceRoot": "apps/gateway/src",
  "compilerOptions": {
    "webpack": true,
    "tsConfigPath": "apps/gateway/tsconfig.app.json",
    "deleteOutDir": true
  },
  "projects": {
    "gateway": { "type": "application", "root": "apps/gateway", "entryFile": "main", "sourceRoot": "apps/gateway/src", "compilerOptions": { "tsConfigPath": "apps/gateway/tsconfig.app.json" } },
    "fleet-core": { "type": "application", "root": "apps/fleet-core", "entryFile": "main", "sourceRoot": "apps/fleet-core/src", "compilerOptions": { "tsConfigPath": "apps/fleet-core/tsconfig.app.json" } },
    "telemetry-ingest": { "type": "application", "root": "apps/telemetry-ingest", "entryFile": "main", "sourceRoot": "apps/telemetry-ingest/src", "compilerOptions": { "tsConfigPath": "apps/telemetry-ingest/tsconfig.app.json" } },
    "geofence-service": { "type": "application", "root": "apps/geofence-service", "entryFile": "main", "sourceRoot": "apps/geofence-service/src", "compilerOptions": { "tsConfigPath": "apps/geofence-service/tsconfig.app.json" } },
    "dispatch-order": { "type": "application", "root": "apps/dispatch-order", "entryFile": "main", "sourceRoot": "apps/dispatch-order/src", "compilerOptions": { "tsConfigPath": "apps/dispatch-order/tsconfig.app.json" } },
    "analytics": { "type": "application", "root": "apps/analytics", "entryFile": "main", "sourceRoot": "apps/analytics/src", "compilerOptions": { "tsConfigPath": "apps/analytics/tsconfig.app.json" } },
    "migrator": { "type": "application", "root": "apps/migrator", "entryFile": "main", "sourceRoot": "apps/migrator/src", "compilerOptions": { "tsConfigPath": "apps/migrator/tsconfig.app.json" } },
    "common": { "type": "library", "root": "libs/common", "entryFile": "index", "sourceRoot": "libs/common/src", "compilerOptions": { "tsConfigPath": "libs/common/tsconfig.lib.json" } },
    "database": { "type": "library", "root": "libs/database", "entryFile": "index", "sourceRoot": "libs/database/src", "compilerOptions": { "tsConfigPath": "libs/database/tsconfig.lib.json" } }
  }
}
